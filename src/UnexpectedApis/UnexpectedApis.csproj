<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0-android;net11.0-ios;net11.0-tvos;net11.0-windows10.0.26100;net11.0-browserwasm;net11.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>Unexpected APIs</ApplicationTitle>
    <ApplicationId>dev.zikmund.unexpectedapis</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Martin Zikmund</ApplicationPublisher>
    <Description>Unexpected APIs: live controls and platform APIs of Uno Platform.</Description>

    <!-- https://aka.platform.uno/singleproject-features -->
    <UnoFeatures>
      Mvvm;
      SkiaRenderer;
      SpellChecking;
    </UnoFeatures>
  </PropertyGroup>

  <!-- GitHub Pages serves the app from /<repo>/; CI passes the base path. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-browserwasm' and '$(AppBasePath)' != ''">
    <WasmShellWebAppBasePath>$(AppBasePath)</WasmShellWebAppBasePath>
  </PropertyGroup>
</Project>
