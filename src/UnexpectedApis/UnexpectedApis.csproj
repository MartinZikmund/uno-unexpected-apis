<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0-android;net11.0-ios;net11.0-tvos;net11.0-windows10.0.26100;net11.0-browserwasm;net11.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UnoSingleProject>true</UnoSingleProject>

    <ApplicationTitle>Unexpected APIs</ApplicationTitle>
    <ApplicationId>dev.zikmund.unexpectedapis</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Martin Zikmund</ApplicationPublisher>
    <Description>Unexpected APIs: live controls and platform APIs of Uno Platform.</Description>

    <!-- https://aka.platform.uno/singleproject-features -->
    <UnoFeatures>
      GLCanvas;
      MediaElement;
      WebView;
      Mvvm;
      SkiaRenderer;
      SpellChecking;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" />
    <PackageReference Include="Mapsui.WinUI" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <PackageReference Include="Uno.CommunityToolkit.WinUI.UI.Controls.DataGrid" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-browserwasm'">
    <!-- The GLCanvas feature only adds this on desktop and Windows; keep it on the SDK's Uno version. -->
    <PackageReference Include="Uno.WinUI.Graphics3DGL" VersionOverride="$(UnoVersion)" />
  </ItemGroup>

  <!-- Relative, so the web app also works when hosted below a domain root. -->
  <PropertyGroup>
    <WasmShellWebAppBasePath>./</WasmShellWebAppBasePath>
  </PropertyGroup>
</Project>
