<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFECE8FF" />
        <GradientStop Offset="0.55" Color="#FFF3F0FF" />
        <GradientStop Offset="1" Color="#FFE3F4FF" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FFF3F3F6" />
      <SolidColorBrush x:Key="StageBackgroundBrush" Color="#FFFAFAFC" />
      <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#FFF6F6FA" />
      <SolidColorBrush x:Key="CodeTagBrush" Color="#FF4A35C9" />
      <SolidColorBrush x:Key="CodeAttributeBrush" Color="#FF0B6A8F" />
      <SolidColorBrush x:Key="CodeValueBrush" Color="#FFA3361F" />
      <SolidColorBrush x:Key="CodePunctuationBrush" Color="#FF6B6B7B" />
      <SolidColorBrush x:Key="CodeCommentBrush" Color="#FF5F7A5F" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF2A2352" />
        <GradientStop Offset="0.55" Color="#FF1F1C38" />
        <GradientStop Offset="1" Color="#FF14283A" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FF16161C" />
      <SolidColorBrush x:Key="StageBackgroundBrush" Color="#FF1B1B22" />
      <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#FF15151B" />
      <SolidColorBrush x:Key="CodeTagBrush" Color="#FFB4A7FF" />
      <SolidColorBrush x:Key="CodeAttributeBrush" Color="#FF7FD4F5" />
      <SolidColorBrush x:Key="CodeValueBrush" Color="#FFFFB59E" />
      <SolidColorBrush x:Key="CodePunctuationBrush" Color="#FF9090A0" />
      <SolidColorBrush x:Key="CodeCommentBrush" Color="#FF8FB08F" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="HighContrast">
      <StaticResource x:Key="HeroBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
      <StaticResource x:Key="ShellBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
      <StaticResource x:Key="StageBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
      <StaticResource x:Key="CodeBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
      <StaticResource x:Key="CodeTagBrush" ResourceKey="SystemColorHotlightColorBrush" />
      <StaticResource x:Key="CodeAttributeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="CodeValueBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="CodePunctuationBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="CodeCommentBrush" ResourceKey="SystemColorGrayTextColorBrush" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- The brand accent, in the ramp Fluent derives its accent brushes from. -->
  <Color x:Key="SystemAccentColor">#FF6750E8</Color>
  <Color x:Key="SystemAccentColorLight1">#FF7F6CF0</Color>
  <Color x:Key="SystemAccentColorLight2">#FF9C8DF5</Color>
  <Color x:Key="SystemAccentColorLight3">#FFBFB5FA</Color>
  <Color x:Key="SystemAccentColorDark1">#FF5640CF</Color>
  <Color x:Key="SystemAccentColorDark2">#FF4531AF</Color>
  <Color x:Key="SystemAccentColorDark3">#FF33238A</Color>

  <FontFamily x:Key="CodeFontFamily">Cascadia Code, Consolas, monospace</FontFamily>

  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
  </Style>

  <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="MutedCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>
</ResourceDictionary>
