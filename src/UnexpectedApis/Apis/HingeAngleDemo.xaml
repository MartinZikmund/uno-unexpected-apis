<UserControl x:Class="UnexpectedApis.Apis.HingeAngleDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel MaxWidth="360" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock x:Name="AngleText"
               AutomationProperties.AutomationId="HingeAngleValue"
               HorizontalAlignment="Center"
               Style="{StaticResource TitleLargeTextBlockStyle}"
               Text="-" />
    <TextBlock x:Name="StatusText"
               AutomationProperties.AutomationId="HingeAngleStatus"
               HorizontalAlignment="Center"
               Style="{StaticResource BodyTextBlockStyle}"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               Text="Looking for a hinge sensor..." />
  </StackPanel>
</UserControl>
