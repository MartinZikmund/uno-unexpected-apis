<UserControl x:Class="UnexpectedApis.Apis.AcrylicBrushDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="16" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Viewbox>
      <Grid Width="420" Height="420">
        <Grid ColumnSpacing="8" RowSpacing="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="200" />
          </Grid.ColumnDefinitions>
          <Rectangle Fill="#f34f1c" />
          <Rectangle Grid.Column="1" Fill="#7fbc00" />
          <Rectangle Grid.Row="1" Fill="#01a6f0" />
          <Rectangle Grid.Row="1" Grid.Column="1" Fill="#ffba01" />
        </Grid>
        <Border Width="320" Height="320" CornerRadius="160" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border.Background>
            <AcrylicBrush x:Name="Acrylic"
                          FallbackColor="Green"
                          TintColor="#333333"
                          TintLuminosityOpacity="0.5"
                          TintOpacity="0.5" />
          </Border.Background>
        </Border>
      </Grid>
    </Viewbox>

    <StackPanel Grid.Row="1" Width="320" HorizontalAlignment="Center" Spacing="8">
      <Slider x:Name="TintSlider"
              AutomationProperties.AutomationId="AcrylicTintOpacity"
              Header="Tint opacity"
              LargeChange="0.1"
              Maximum="1"
              Minimum="0"
              SmallChange="0.01"
              StepFrequency="0.01"
              Value="0.5"
              ValueChanged="OnTintOpacityChanged" />
      <Slider x:Name="LuminositySlider"
              AutomationProperties.AutomationId="AcrylicLuminosityOpacity"
              Header="Tint luminosity opacity"
              LargeChange="0.1"
              Maximum="1"
              Minimum="0"
              SmallChange="0.01"
              StepFrequency="0.01"
              Value="0.5"
              ValueChanged="OnLuminosityChanged" />
      <Button AutomationProperties.AutomationId="AcrylicPickColor" Content="Pick tint color">
        <Button.Flyout>
          <Flyout>
            <ColorPicker x:Name="TintPicker"
                         Color="#333333"
                         ColorChanged="OnTintColorChanged"
                         IsAlphaEnabled="False" />
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
