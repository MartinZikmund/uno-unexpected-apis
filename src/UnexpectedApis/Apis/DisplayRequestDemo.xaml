<UserControl x:Class="UnexpectedApis.Apis.DisplayRequestDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel MaxWidth="360" Spacing="16" VerticalAlignment="Center">
    <TextBlock Style="{StaticResource BodyTextBlockStyle}"
               TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               Text="Keeps the screen on even when the device is idle." />
    <ToggleSwitch x:Name="KeepOnSwitch"
                  AutomationProperties.AutomationId="DisplayRequestKeepOn"
                  OffContent="Screen can turn off"
                  OnContent="Screen stays on"
                  Toggled="OnKeepOnToggled" />
    <TextBlock x:Name="StatusText"
               AutomationProperties.AutomationId="DisplayRequestStatus"
               Style="{StaticResource CaptionTextBlockStyle}"
               TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
  </StackPanel>
</UserControl>
