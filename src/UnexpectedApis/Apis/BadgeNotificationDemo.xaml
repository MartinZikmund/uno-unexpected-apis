<UserControl x:Class="UnexpectedApis.Apis.BadgeNotificationDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel MaxWidth="240" Spacing="8" VerticalAlignment="Center">
    <NumberBox x:Name="BadgeBox" AutomationProperties.AutomationId="BadgeValue"
               Header="Badge number" Minimum="0" SpinButtonPlacementMode="Inline" Value="42" />
    <Button AutomationProperties.AutomationId="BadgeSet" HorizontalAlignment="Stretch"
            Style="{StaticResource AccentButtonStyle}" Click="OnSetClick">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <SymbolIcon Symbol="Save" />
        <TextBlock Text="Set badge" />
      </StackPanel>
    </Button>
    <Button AutomationProperties.AutomationId="BadgeClear" HorizontalAlignment="Stretch" Click="OnClearClick">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <SymbolIcon Symbol="Clear" />
        <TextBlock Text="Clear badge" />
      </StackPanel>
    </Button>
    <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="BadgeStatus" TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
  </StackPanel>
</UserControl>
