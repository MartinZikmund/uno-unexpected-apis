<UserControl x:Class="UnexpectedApis.Apis.GamepadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <ImageSource x:Key="GamepadImage">ms-appx:///Assets/Apis/Gamepad/gamepad_light.svg</ImageSource>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <ImageSource x:Key="GamepadImage">ms-appx:///Assets/Apis/Gamepad/gamepad_dark.svg</ImageSource>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid ColumnSpacing="24" RowSpacing="12" Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
        CornerRadius="{ThemeResource OverlayCornerRadius}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Canvas Width="260" Height="150" VerticalAlignment="Top">
      <Image Canvas.Left="41" Canvas.Top="29" Height="121" Source="{ThemeResource GamepadImage}" />
        <Ellipse x:Name="LeftStick" Canvas.Left="0" Canvas.Top="0" Width="20" Height="20" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="RightStick" Canvas.Left="0" Canvas.Top="0" Width="20" Height="20" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="ButtonA" Canvas.Left="166.5" Canvas.Top="63" Width="11" Height="11" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="ButtonX" Canvas.Left="157" Canvas.Top="53" Width="11" Height="11" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="ButtonY" Canvas.Left="166.5" Canvas.Top="43" Width="11" Height="11" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="ButtonB" Canvas.Left="177" Canvas.Top="53" Width="11" Height="11" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="DPadDown" Canvas.Left="100" Canvas.Top="93" Width="11" Height="11" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="DPadLeft" Canvas.Left="90" Canvas.Top="83" Width="11" Height="11" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="DPadUp" Canvas.Left="100" Canvas.Top="73" Width="11" Height="11" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="DPadRight" Canvas.Left="110" Canvas.Top="83" Width="11" Height="11" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="ButtonView" Canvas.Left="110" Canvas.Top="55" Width="10" Height="10" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Ellipse x:Name="ButtonMenu" Canvas.Left="136" Canvas.Top="55" Width="10" Height="10" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Rectangle x:Name="Paddle1" Canvas.Left="93" Canvas.Top="128" Width="25" Height="8" RadiusX="3" RadiusY="3" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Rectangle x:Name="Paddle2" Canvas.Left="93" Canvas.Top="142" Width="25" Height="8" RadiusX="3" RadiusY="3" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Rectangle x:Name="Paddle3" Canvas.Left="139" Canvas.Top="128" Width="25" Height="8" RadiusX="3" RadiusY="3" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Rectangle x:Name="Paddle4" Canvas.Left="139" Canvas.Top="142" Width="25" Height="8" RadiusX="3" RadiusY="3" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Rectangle x:Name="LeftShoulder" Canvas.Left="77" Canvas.Top="19" Width="25" Height="8" RadiusX="3" RadiusY="3" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
        <Rectangle x:Name="RightShoulder" Canvas.Left="155" Canvas.Top="19" Width="25" Height="8" RadiusX="3" RadiusY="3" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" />

      <Rectangle Canvas.Left="89" Width="13" Height="17" RadiusX="6" RadiusY="6"
                 Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2">
        <Rectangle.Fill>
          <SolidColorBrush x:Name="LeftTriggerFill" Opacity="0" Color="{ThemeResource SystemAccentColor}" />
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle Canvas.Left="155" Width="13" Height="17" RadiusX="6" RadiusY="6"
                 Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2">
        <Rectangle.Fill>
          <SolidColorBrush x:Name="RightTriggerFill" Opacity="0" Color="{ThemeResource SystemAccentColor}" />
        </Rectangle.Fill>
      </Rectangle>
    </Canvas>

    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
      <TextBlock x:Name="TitleText" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <TextBlock x:Name="ButtonsText" TextWrapping="Wrap" />
      <TextBlock x:Name="LeftStickText" Style="{ThemeResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="RightStickText" Style="{ThemeResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="TriggersText" Style="{ThemeResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
