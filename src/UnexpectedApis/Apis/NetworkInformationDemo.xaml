<UserControl x:Class="UnexpectedApis.Apis.NetworkInformationDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
      <Button AutomationProperties.AutomationId="NetworkCheck" Click="OnCheckClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <SymbolIcon Symbol="Refresh" />
          <TextBlock Text="Check connectivity" />
        </StackPanel>
      </Button>
      <ToggleButton x:Name="ObserveToggle" AutomationProperties.AutomationId="NetworkObserve"
                    Checked="OnObserveChecked" Unchecked="OnObserveUnchecked">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <SymbolIcon Symbol="View" />
          <TextBlock Text="Observe connectivity" />
        </StackPanel>
      </ToggleButton>
    </StackPanel>
    <Grid Width="160" Height="160" HorizontalAlignment="Center">
      <Image x:Name="OnlineImage" Width="120" Height="120" Visibility="Collapsed"
             Source="ms-appx:///Assets/Apis/NetworkInformation/Online.png" />
      <Image x:Name="OfflineImage" Width="120" Height="120" Visibility="Collapsed"
             Source="ms-appx:///Assets/Apis/NetworkInformation/Offline.png" />
    </Grid>
    <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="NetworkStatus"
               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
  </StackPanel>
</UserControl>
