<UserControl x:Class="UnexpectedApis.Apis.CompassDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel MaxWidth="360" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid x:Name="Dial" Width="180" Height="180" HorizontalAlignment="Center">
      <Ellipse Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
               StrokeThickness="2"
               Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Style="{StaticResource CaptionTextBlockStyle}" Text="N" />
      <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <RotateTransform x:Name="NeedleRotation" />
        </Grid.RenderTransform>
        <Polygon Points="90,24 100,90 80,90"
                 Fill="{ThemeResource SystemFillColorCriticalBrush}" />
        <Polygon Points="90,156 100,90 80,90"
                 Fill="{ThemeResource TextFillColorTertiaryBrush}" />
      </Grid>
    </Grid>
    <TextBlock x:Name="HeadingText"
               AutomationProperties.AutomationId="CompassHeading"
               HorizontalAlignment="Center"
               Style="{StaticResource TitleTextBlockStyle}"
               Text="-" />
    <TextBlock x:Name="StatusText"
               AutomationProperties.AutomationId="CompassStatus"
               HorizontalAlignment="Center"
               Style="{StaticResource BodyTextBlockStyle}"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
  </StackPanel>
</UserControl>
