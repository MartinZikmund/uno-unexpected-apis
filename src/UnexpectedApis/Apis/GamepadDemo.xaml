<UserControl x:Class="UnexpectedApis.Apis.GamepadDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid RowSpacing="12" Padding="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="8">
      <ToggleSwitch x:Name="ObserveSwitch"
                    AutomationProperties.AutomationId="GamepadObserve"
                    Header="Observe gamepads"
                    IsOn="True"
                    Toggled="OnObserveToggled" />
      <TextBlock x:Name="StatusText"
                 AutomationProperties.AutomationId="GamepadStatus"
                 TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <StackPanel x:Name="GamepadsPanel" Spacing="12" />
    </ScrollViewer>
  </Grid>
</UserControl>
