<UserControl x:Class="UnexpectedApis.Apis.LauncherDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel MaxWidth="420" Spacing="12" VerticalAlignment="Center">
    <TextBox x:Name="UriBox" AutomationProperties.AutomationId="LauncherUri"
             Header="URI to open" PlaceholderText="Enter a URI" Text="https://platform.uno/" />
    <Button AutomationProperties.AutomationId="LauncherLaunch" Style="{StaticResource AccentButtonStyle}"
            Click="OnLaunchClick">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <SymbolIcon Symbol="Go" />
        <TextBlock Text="Launch" />
      </StackPanel>
    </Button>
    <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="LauncherStatus" TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
  </StackPanel>
</UserControl>
