<UserControl x:Class="UnexpectedApis.Apis.MapsUIDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <Grid x:Name="MapHost" />

    <Button x:Name="LocateButton"
            AutomationProperties.AutomationId="MapsUILocate"
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="OnLocateClick"
            Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <SymbolIcon Symbol="Map" />
        <TextBlock Text="Go to my location" />
      </StackPanel>
    </Button>

    <TextBlock x:Name="MessageText"
               AutomationProperties.AutomationId="MapsUIMessage"
               Margin="24"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Visibility="Collapsed" />
  </Grid>
</UserControl>
