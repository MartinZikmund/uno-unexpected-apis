<UserControl x:Class="UnexpectedApis.Apis.JumpListDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer>
    <StackPanel MaxWidth="420" Padding="16" Spacing="12" HorizontalAlignment="Center">
      <InfoBar AutomationProperties.AutomationId="JumpListUnsupported"
               IsClosable="False"
               IsOpen="{x:Bind Model.IsUnsupported}"
               Severity="Informational"
               Message="Jump lists need Windows, Android or iOS. This platform doesn't have one." />

      <Button AutomationProperties.AutomationId="JumpListLoad"
              Command="{x:Bind Model.LoadCurrentCommand}"
              Content="Load current items"
              Style="{StaticResource AccentButtonStyle}" />

      <ListView AutomationProperties.AutomationId="JumpListItems"
                MinHeight="96"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                ItemsSource="{x:Bind Model.Items}"
                SelectedItem="{x:Bind Model.SelectedItem, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate>
            <StackPanel Padding="0,8">
              <TextBlock Text="{Binding DisplayName}" />
              <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Text="{Binding Description}" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <Button AutomationProperties.AutomationId="JumpListRemove"
              Command="{x:Bind Model.RemoveItemCommand}"
              Content="Remove item" />

      <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind Model.IsLoaded, Mode=OneWay}">
        <StackPanel Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Spacing="8">
        <TextBox AutomationProperties.AutomationId="JumpListArguments" Header="Arguments"
                 Text="{x:Bind Model.Arguments, Mode=TwoWay}" />
        <TextBox AutomationProperties.AutomationId="JumpListDisplayName" Header="Display name"
                 Text="{x:Bind Model.DisplayName, Mode=TwoWay}" />
        <TextBox AutomationProperties.AutomationId="JumpListDescription" Header="Description"
                 Text="{x:Bind Model.Description, Mode=TwoWay}" />
        <ComboBox AutomationProperties.AutomationId="JumpListIcon"
                  Header="Icon"
                  ItemsSource="{x:Bind Model.Icons}"
                  SelectedItem="{x:Bind Model.Logo, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <BitmapIcon Width="32" Height="32" ShowAsMonochrome="False" UriSource="{Binding}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button AutomationProperties.AutomationId="JumpListAdd"
                Command="{x:Bind Model.AddItemCommand}"
                Content="Add item" />
        </StackPanel>
      </ContentControl>

      <TextBlock AutomationProperties.AutomationId="JumpListStatus"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 Text="{x:Bind Model.Status, Mode=OneWay}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
