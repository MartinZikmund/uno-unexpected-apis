<UserControl x:Class="UnexpectedApis.Apis.FlashlightDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StackPanel MaxWidth="360" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
    <ToggleButton x:Name="LampToggle"
                  AutomationProperties.AutomationId="FlashlightToggle"
                  Width="120"
                  Height="120"
                  HorizontalAlignment="Center"
                  CornerRadius="60"
                  IsEnabled="False"
                  Checked="OnLampToggled"
                  Unchecked="OnLampToggled">
      <StackPanel Spacing="4">
        <SymbolIcon Symbol="Highlight" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Flashlight" />
      </StackPanel>
    </ToggleButton>
    <TextBlock x:Name="StatusText"
               AutomationProperties.AutomationId="FlashlightStatus"
               HorizontalAlignment="Center"
               Style="{StaticResource BodyTextBlockStyle}"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               Text="Looking for a flashlight..." />
  </StackPanel>
</UserControl>
