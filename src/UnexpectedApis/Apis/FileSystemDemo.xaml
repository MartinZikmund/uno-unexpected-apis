<UserControl x:Class="UnexpectedApis.Apis.FileSystemDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:storage="using:Windows.Storage">

  <Grid ColumnSpacing="8" RowSpacing="8" Padding="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Button AutomationProperties.AutomationId="FsAppFolder" HorizontalAlignment="Stretch"
            Style="{StaticResource AccentButtonStyle}" Click="OnUseAppFolderClick">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <SymbolIcon Symbol="Home" />
        <TextBlock Text="Use the app folder" />
      </StackPanel>
    </Button>
    <Button AutomationProperties.AutomationId="FsPickFolder" Grid.Column="1" HorizontalAlignment="Stretch"
            Click="OnPickFolderClick">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <SymbolIcon Symbol="OpenLocal" />
        <TextBlock Text="Pick a folder" />
      </StackPanel>
    </Button>

    <TextBox x:Name="FileNameBox" AutomationProperties.AutomationId="FsFileName" Grid.Row="1"
             Header="File name" Text="Hello.txt" IsEnabled="False" />
    <Button x:Name="CreateButton" AutomationProperties.AutomationId="FsCreate" Grid.Row="1" Grid.Column="1"
            VerticalAlignment="Bottom" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnCreateClick">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <SymbolIcon Symbol="Add" />
        <TextBlock Text="Create file" />
      </StackPanel>
    </Button>

    <TextBox x:Name="ContentBox" AutomationProperties.AutomationId="FsContent" Grid.Row="2"
             Header="Content of the selected file" IsEnabled="False" />
    <Button x:Name="WriteButton" AutomationProperties.AutomationId="FsWrite" Grid.Row="2" Grid.Column="1"
            VerticalAlignment="Bottom" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnWriteClick">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <SymbolIcon Symbol="Save" />
        <TextBlock Text="Write to file" />
      </StackPanel>
    </Button>

    <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="FsStatus" Grid.Row="3" Grid.ColumnSpan="2"
               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
               Text="Choose a folder to start." />

    <ListView x:Name="FilesList" AutomationProperties.AutomationId="FsFiles" Grid.Row="4" Grid.ColumnSpan="2"
              ItemsSource="{x:Bind Files}" SelectionChanged="OnFileSelected">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="storage:StorageFile">
          <TextBlock Text="{x:Bind Name}" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
