<Page x:Class="UnexpectedApis.Pages.SamplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:catalog="using:UnexpectedApis.Catalog"
      xmlns:pages="using:UnexpectedApis.Pages"
      xmlns:views="using:UnexpectedApis.Views">

  <Page.Resources>
    <DataTemplate x:Key="BoolKnobTemplate" x:DataType="catalog:BoolKnob">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <ToggleSwitch Grid.Column="1" MinWidth="0" AutomationProperties.Name="{x:Bind Name}"
                      OnContent="True" OffContent="False" IsOn="{x:Bind Value, Mode=TwoWay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TextKnobTemplate" x:DataType="catalog:TextKnob">
      <TextBox Header="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}"
               Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>

    <DataTemplate x:Key="NumberKnobTemplate" x:DataType="catalog:NumberKnob">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{x:Bind XamlValue, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Slider AutomationProperties.Name="{x:Bind Name}" Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}"
                StepFrequency="{x:Bind Step}" Value="{x:Bind Value, Mode=TwoWay}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ChoiceKnobTemplate" x:DataType="catalog:ChoiceKnob">
      <ComboBox Header="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}" HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind Options}" SelectedItem="{x:Bind SelectedOption, Mode=TwoWay}" />
    </DataTemplate>

    <pages:KnobTemplateSelector x:Key="KnobSelector"
                                BoolTemplate="{StaticResource BoolKnobTemplate}"
                                TextTemplate="{StaticResource TextKnobTemplate}"
                                NumberTemplate="{StaticResource NumberKnobTemplate}"
                                ChoiceTemplate="{StaticResource ChoiceKnobTemplate}" />
  </Page.Resources>

  <ScrollViewer>
    <Grid x:Name="Layout" Padding="32,24,32,48" RowSpacing="24" ColumnSpacing="24" MaxWidth="1480">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PropertiesColumn" Width="320" />
      </Grid.ColumnDefinitions>

      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="Wide">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="1180" />
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="Narrow">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="PropertiesColumn.Width" Value="0" />
              <Setter Target="PropertiesPanel.(Grid.Column)" Value="0" />
              <Setter Target="PropertiesPanel.(Grid.Row)" Value="2" />
              <Setter Target="PropertiesPanel.(Grid.RowSpan)" Value="1" />
              <Setter Target="LowerStack.(Grid.Row)" Value="3" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>

      <!-- Header -->
      <Grid Grid.ColumnSpan="2" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock x:Name="CategoryText" Style="{StaticResource SectionLabelStyle}" />
          <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
          <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="PlatformsText"
                     AutomationProperties.AutomationId="SamplePlatforms"
                     Visibility="Collapsed"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <InfoBar x:Name="UnsupportedBar"
                   AutomationProperties.AutomationId="UnsupportedPlatform"
                   Margin="0,8,0,0"
                   Severity="Warning"
                   IsClosable="False" />
        </StackPanel>
        <ToggleButton x:Name="FavoriteButton"
                      AutomationProperties.AutomationId="FavoriteButton"
                      AutomationProperties.Name="Add to favorites"
                      Grid.Column="1"
                      VerticalAlignment="Top"
                      Click="OnFavoriteClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="Favorite" />
            <TextBlock Text="Favorite" />
          </StackPanel>
        </ToggleButton>
        <Button AutomationProperties.AutomationId="DocsButton" Grid.Column="2" VerticalAlignment="Top" Click="OnDocsClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <SymbolIcon Symbol="Link" />
            <TextBlock Text="API docs" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Stage -->
      <Border x:Name="StageCard" Grid.Row="1" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="StageToolbar" Padding="16,8" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="ThemeModes" AutomationProperties.Name="Preview theme" SelectionChanged="OnThemeModeChanged">
              <SelectorBarItem Text="App theme" Tag="App" IsSelected="True" />
              <SelectorBarItem Text="Light" Tag="Light" />
              <SelectorBarItem Text="Dark" Tag="Dark" />
              <SelectorBarItem Text="Both" Tag="Both" />
            </SelectorBar>
            <ComboBox x:Name="WidthBox"
                      AutomationProperties.AutomationId="PreviewWidth"
                      AutomationProperties.Name="Preview width"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      MinWidth="136"
                      SelectedIndex="0"
                      SelectionChanged="OnWidthChanged">
              <x:String>Fit the stage</x:String>
              <x:String>720 wide</x:String>
              <x:String>480 wide</x:String>
              <x:String>320 wide</x:String>
            </ComboBox>
          </Grid>
          <Grid x:Name="StageHost" Grid.Row="1" />
        </Grid>
      </Border>

      <!-- Snippet and tips -->
      <StackPanel x:Name="LowerStack" Grid.Row="2" Spacing="24">
        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Padding="16,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SnippetLabel" Text="XAML" VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" />
              <Button AutomationProperties.AutomationId="CopySnippet" Grid.Column="1" Click="OnCopyClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <SymbolIcon Symbol="Copy" />
                  <TextBlock x:Name="CopyLabel" Text="Copy" />
                </StackPanel>
              </Button>
            </Grid>
            <views:CodeView x:Name="Code" Grid.Row="1" />
          </Grid>
        </Border>

        <StackPanel x:Name="TipsSection" Spacing="8">
          <TextBlock Text="Worth knowing" Style="{StaticResource SubtitleTextBlockStyle}" />
          <ItemsControl x:Name="TipsList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Style="{StaticResource CardStyle}" Padding="16,12">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Symbol="Important" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <!-- Properties -->
      <Border x:Name="PropertiesPanel" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1"
              Style="{StaticResource CardStyle}" VerticalAlignment="Top" Padding="16">
        <StackPanel Spacing="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Properties" VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" />
            <Button x:Name="ResetButton" AutomationProperties.AutomationId="ResetKnobs" Grid.Column="1" Content="Reset" Click="OnResetClick" />
          </Grid>
          <TextBlock x:Name="NoKnobsText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Text="Nothing to tweak here. Try the control itself on the stage." />
          <ItemsControl x:Name="KnobsList" ItemTemplateSelector="{StaticResource KnobSelector}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</Page>
