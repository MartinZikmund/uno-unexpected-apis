<Page x:Class="UnexpectedApis.Pages.IconsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="using:UnexpectedApis.Pages"
      xmlns:views="using:UnexpectedApis.Views">

  <Grid Padding="32,24,32,24" RowSpacing="16" ColumnSpacing="24" MaxWidth="1480">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.ColumnSpan="2" Spacing="4">
      <TextBlock Text="Design tokens" Style="{StaticResource SectionLabelStyle}" />
      <TextBlock Text="Icons" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <TextBox x:Name="FilterBox" AutomationProperties.AutomationId="IconFilter" AutomationProperties.Name="Filter icons"
             Grid.Row="1" MaxWidth="360" MinWidth="360" HorizontalAlignment="Left" PlaceholderText="Filter: save, mail, arrow..." TextChanged="OnFilterChanged" />

    <GridView x:Name="IconGrid" AutomationProperties.AutomationId="IconGrid" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnIconSelected">
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="pages:IconToken">
          <StackPanel Width="96" Height="88" Spacing="8" Padding="4,12" ToolTipService.ToolTip="{x:Bind Name}">
            <SymbolIcon Symbol="{x:Bind Symbol}" />
            <TextBlock Text="{x:Bind Name}" Style="{StaticResource MutedCaptionStyle}" HorizontalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>

    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
      <StackPanel Spacing="16" Padding="16">
        <Border Height="120" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource StageBackgroundBrush}">
          <Viewbox Width="56" Height="56">
            <SymbolIcon x:Name="PreviewIcon" />
          </Viewbox>
        </Border>
        <StackPanel Spacing="4">
          <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock x:Name="DetailCode" Style="{StaticResource MutedCaptionStyle}" IsTextSelectionEnabled="True" />
        </StackPanel>

        <StackPanel Spacing="8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="SymbolIcon" VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" />
            <Button AutomationProperties.AutomationId="CopySymbolIcon" Grid.Column="1" Content="Copy" Click="OnCopySymbol" />
          </Grid>
          <Border CornerRadius="{StaticResource ControlCornerRadius}">
            <views:CodeView x:Name="SymbolCode" />
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="FontIcon" VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" />
            <Button AutomationProperties.AutomationId="CopyFontIcon" Grid.Column="1" Content="Copy" Click="OnCopyFont" />
          </Grid>
          <Border CornerRadius="{StaticResource ControlCornerRadius}">
            <views:CodeView x:Name="FontCode" WrapLines="True" />
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Page>
